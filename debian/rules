#!/usr/bin/make -f
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 The Blueberry Pie OS Authors

include /usr/share/pietoolchain/rules.mk

BINUTILS := $(TOOLCHAIN)/prefix/bin/aarch64-apple-darwin
CONFIGURE_FLAGS := --host=aarch64-apple-darwin --build=$(shell uname -m)-pc-linux-gnu \
	--prefix=/usr --disable-static --disable-doc --disable-jent-support --disable-asm \
	--enable-ciphers="aes twofish blowfish cast5 des camellia idea" \
	--enable-pubkey-ciphers="rsa dsa elgamal ecc kyber" \
	--enable-digests="crc md5 rmd160 sha1 sha256 sha512 sha3 blake2" \
	--enable-kdfs="s2k pkdf2"

$(OBJ)/.configured:
	@mkdir -p $(OBJ)
	cd $(SRCROOT) && { test -e debian/autotools-tree || find . \( -path ./debian -o -path ./.git -o -path ./.pc \) -prune -o -print | LC_ALL=C sort > debian/autotools-tree; }
	cd $(SRCROOT) && { rc=0; autoreconf -fi > $(OBJ)/autoreconf.log 2>&1 || rc=$$?; \
		find . \( -path ./debian -o -path ./.git -o -path ./.pc \) -prune -o -print | LC_ALL=C sort | LC_ALL=C comm -13 debian/autotools-tree - > debian/autotools-generated; \
		[ $$rc = 0 ] || { cat $(OBJ)/autoreconf.log; exit $$rc; }; }
	cd $(OBJ) && CC=$(CC) CFLAGS="$(BASE_CFLAGS)" LDFLAGS="$(BASE_LDFLAGS)" \
		AR=$(BINUTILS)-ar RANLIB=$(BINUTILS)-ranlib NM=$(NM) STRIP=$(STRIP) LD=$(BINUTILS)-ld \
		OTOOL=$(BINUTILS)-otool LIPO=$(BINUTILS)-lipo NMEDIT=$(BINUTILS)-nmedit \
		GPGRT_CONFIG=$(PIE_CROSS_ROOT)/usr/bin/gpgrt-config \
		$(SRCROOT)/configure $(CONFIGURE_FLAGS) > configure.log
	touch $@

$(OBJ)/.built: $(OBJ)/.configured
	set -e; for d in compat mpi cipher random; do $(MAKE) -C $(OBJ)/$$d -j$(JOBS); done
	$(MAKE) -C $(OBJ)/src -j$(JOBS) libgcrypt.la
	touch $@

install: $(OBJ)/.built
	$(MAKE) -C $(OBJ)/src DESTDIR=$(ROOT) install-libLTLIBRARIES install-nodist_includeHEADERS \
		install-m4dataDATA install-pkgconfigDATA
	rm -f $(ROOT)/usr/lib/libgcrypt.la

autotools-clean:
	if [ -f debian/autotools-generated ]; then LC_ALL=C sort -r debian/autotools-generated | while read -r f; do \
		if [ -d "$$f" ]; then rmdir "$$f" 2>/dev/null || rm -rf "$$f"; else rm -f "$$f"; fi; done; \
		rm -f debian/autotools-generated; fi
	rm -f debian/autotools-tree

clean: autotools-clean

.PHONY: install autotools-clean
