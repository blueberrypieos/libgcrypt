+# Modified 2026-11-04: automake runs in foreign mode (LGPL-2.1 section 2(b)).
+# Modified 2026-11-04: the Windows version resource is not configured (LGPL-2.1 section 2(b)).
+# Modified 2026-11-04: libgcrypt-config is not made (LGPL-2.1 section 2(b)).
+# Modified 2026-11-04: AX_CC_FOR_BUILD is not used (LGPL-2.1 section 2(b)).
+# Modified 2026-11-04: m4/Makefile is not configured (LGPL-2.1 section 2(b)).
 
 # (Process this file with autoconf to produce a configure script.)
 AC_REVISION($Revision$)
@@ -80,7 +85,7 @@
 
 AC_CONFIG_AUX_DIR([build-aux])
 AC_CONFIG_SRCDIR([src/libgcrypt.vers])
-AM_INIT_AUTOMAKE([serial-tests dist-bzip2])
+AM_INIT_AUTOMAKE([foreign serial-tests dist-bzip2])
 AC_CONFIG_HEADERS([config.h])
 AC_CONFIG_MACRO_DIR([m4])
 AC_CONFIG_LIBOBJ_DIR([compat])
@@ -192,9 +197,6 @@
                           mym4_minor mym4_micro)
 AC_SUBST(VERSION_NUMBER)
 
-# We need to compile and run a program on the build machine.
-AX_CC_FOR_BUILD
-
 
 LT_PREREQ([2.2.6])
 LT_INIT([win32-dll disable-static])
@@ -3393,7 +3395,6 @@
 AC_SUBST(LIBGCRYPT_THREAD_MODULES)
 
 AC_CONFIG_COMMANDS([gcrypt-conf],[[
-chmod +x src/libgcrypt-config
 ]],[[
 prefix=$prefix
 exec_prefix=$exec_prefix
@@ -4473,16 +4474,13 @@
 # And create the files.
 AC_CONFIG_FILES([
 Makefile
-m4/Makefile
 compat/Makefile
 mpi/Makefile
 cipher/Makefile
 random/Makefile
 src/Makefile
 src/gcrypt.h
-src/libgcrypt-config
 src/libgcrypt.pc
-src/versioninfo.rc
 ])
 AC_OUTPUT
 
